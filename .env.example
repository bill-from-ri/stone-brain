# Copy to .env.local and fill in. Never commit .env.local.

# --- Neon Postgres ---
# Pooled connection, used by the app at runtime.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/stonebrain?sslmode=require"
# Direct (unpooled) connection, used by drizzle-kit for migrations only.
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.region.aws.neon.tech/stonebrain?sslmode=require"

# --- Google OAuth ---
# From Google Cloud console → Credentials → Web application client.
# The spike used a public client with no secret; this server-side flow needs one.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- App ---
# The redirect URI is DERIVED as ${APP_URL}/api/auth/google/callback and is never
# read from a request header. Whatever you put here must match the Authorized
# redirect URI in the Google console character for character.
APP_URL="http://localhost:3000"

# HMAC key for the short-lived OAuth handoff cookie. 32+ bytes.
#   openssl rand -base64 32
SESSION_SECRET=""

# --- Token encryption (see src/lib/crypto/secretbox.ts) ---
# Each TOKEN_ENC_KEY_<ID> must be base64 that decodes to exactly 32 bytes.
#   openssl rand -base64 32
# To rotate: add TOKEN_ENC_KEY_V2, flip TOKEN_ENC_ACTIVE to v2, leave V1 in place
# until the population has drained.
TOKEN_ENC_KEY_V1=""
TOKEN_ENC_ACTIVE="v1"
