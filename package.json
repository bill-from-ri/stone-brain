{
  "name": "stone-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --tsconfig tsconfig.json scripts/seed-ontology.ts",
    "db:seed:world": "tsx --tsconfig tsconfig.json scripts/seed-world.ts",
    "db:seed:kaldia": "tsx --tsconfig tsconfig.json scripts/seed-kaldia.ts",
    "db:seed:runar": "tsx --tsconfig tsconfig.json scripts/seed-runar.ts",
    "db:studio": "drizzle-kit studio",
    "extract": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/extract-document.ts",
    "extract:capture": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/capture-extraction.ts",
    "extract:score": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/score-extraction.ts",
    "db:backfill:inverses": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/backfill-inverses.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/web": "^2.1.2",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^11.0.0",
    "jose": "^6.2.8",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
